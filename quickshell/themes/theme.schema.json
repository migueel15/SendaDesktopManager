{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Senda theme",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "wallpaper",
    "colors"
  ],
  "properties": {
    "name": {
      "type": "string",
      "maxLength": 40,
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "wallpaper": {
      "type": "string",
      "minLength": 1
    },
    "colors": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base",
        "background",
        "surface",
        "border",
        "surfaceVariant",
        "surfaceRaised",
        "surfaceRaisedBorder",
        "overlay",
        "textMuted",
        "white",
        "primary",
        "secondary",
        "accent",
        "accentDeep",
        "selection",
        "focus",
        "success",
        "warning",
        "error",
        "info",
        "text"
      ],
      "properties": {
        "base": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "background": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "surface": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "border": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "surfaceVariant": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "surfaceRaised": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "surfaceRaisedBorder": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "overlay": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "textMuted": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "white": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "primary": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "secondary": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "accent": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "accentDeep": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "selection": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "focus": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "success": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "warning": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "error": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "info": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "text": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        }
      }
    }
  }
}
